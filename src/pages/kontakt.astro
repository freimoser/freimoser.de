---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt — Freimoser" description="Kontaktmöglichkeiten und Links zu S. Thomas Freimoser.">

  <section class="page-header">
    <div class="container">
      <p class="pretitle">Kontakt</p>
      <h1>In Verbindung<br /><span class="text-gradient">bleiben</span></h1>
      <p>Folge mir auf den Plattformen oder schreib mir direkt — ich freue mich auf Austausch.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="link-grid">
        <a href="https://github.com/freimoser" target="_blank" rel="noopener" class="link-card">
          <span class="li-icon">🐙</span>
          <div>
            <div class="li-label">GitHub</div>
            <div class="li-url">github.com/freimoser</div>
          </div>
        </a>

        <a href="https://linkedin.com/in/freimoser" target="_blank" rel="noopener" class="link-card">
          <span class="li-icon">💼</span>
          <div>
            <div class="li-label">LinkedIn</div>
            <div class="li-url">linkedin.com/in/freimoser</div>
          </div>
        </a>

        <a href="https://x.com/freimoser" target="_blank" rel="noopener" class="link-card">
          <span class="li-icon">🐦</span>
          <div>
            <div class="li-label">X / Twitter</div>
            <div class="li-url">@freimoser</div>
          </div>
        </a>

        <a href="https://freimoser.de" class="link-card">
          <span class="li-icon">🌐</span>
          <div>
            <div class="li-label">Web</div>
            <div class="li-url">freimoser.de</div>
          </div>
        </a>
      </div>

      <div class="contact-note">
        <h2>Direktkontakt</h2>
        <p>
          Für geschäftliche Anfragen, Kooperationen oder Projekte schreib mir am besten
          über LinkedIn oder X/Twitter. Ich antworte in der Regel innerhalb von 24 Stunden.
        </p>
      </div>
    </div>
  </section>

</Layout>
